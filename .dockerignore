# Local environments -- app installs its own deps via uv sync in the image
.venv/
**/__pycache__/
*.pyc

.git/
.gitignore

# Bind-mounted at runtime (x-app-common volumes), no need to bake into image

# Raw source PDFs, not needed by the app/dashboard runtime
# CORRECTED: the previous patterns ("data/raw/", "data/processed/") never
# matched anything -- no data/ directory exists in this repo; the real
# paths are "raw/" and "processed/" at repo root, which were never
# actually being excluded until now. Now redundant with the Dockerfile's
# explicit COPY list (which never references these paths at all), kept
# as a safety net in case anything ever reverts to a blanket COPY . .
raw/
processed/

# Not needed inside the app/dashboard image
airflow/
docker/

# Secrets -- mounted read-only via docker-compose, never baked in
*.env
.env

README.md